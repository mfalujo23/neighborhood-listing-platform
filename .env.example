# Server-only configuration for the services and booking routes.
# Set real values in an ignored local environment file or hosting settings.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional public aliases supported by sponsor reads and the server adapter.
# These must never hold a privileged secret.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional older public-key name; used only if configured.
# SUPABASE_ANON_KEY=
# Privileged key is needed only by authenticated administrator routes.
# Never prefix this name with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Keep false outside the explicitly fictional local fixture preview.
MIDTERM_LOCAL_FIXTURE_PREVIEW=false

# Optional local-only audit control. Set before a verification build to show it.
# Normal deployments keep it off. Audits are invoked through the visible UI.
ENABLE_LOCAL_ACCESSIBILITY_AUDIT=false
NEXT_TELEMETRY_DISABLED=1

# Verified voice webhook: exact externally configured callback URL, no secrets
# in the URL. The legacy /api/webhooks/twilio endpoint is retired.
PUBLIC_CALLBACK_URL=
TWILIO_AUTH_TOKEN=
# Temporary staged rotation only. Next token is ignored unless expiry is valid,
# in the future and at most 24 hours away. Keep both blank outside rotation.
TWILIO_AUTH_TOKEN_NEXT=
TWILIO_TOKEN_OVERLAP_EXPIRES_AT=
PROJECT_NAME=
WEBHOOK_STORE_DRIVER=
# local-file is development-only; hosted deployments require durable supabase.
WEBHOOK_LOCAL_STORE_DIR=
ENABLE_OUTBOUND_SMS=false

# Protected analytics are off until the schema and hosted authorization are
# verified. Fixture mode stays distinct from provider-measured telemetry.
ENABLE_ANALYTICS=false
ANALYTICS_FIXTURE_MODE=false
ENABLE_SPONSOR_IMPRESSIONS=false

# Reserved optional provider configuration, not used by the text simulator.
# Do not populate these unless an approved live adapter is implemented/tested.
# TWILIO_ACCOUNT_SID=
# TWILIO_PHONE_NUMBER=
# VAPI_PRIVATE_KEY=
# VAPI_ASSISTANT_ID=
# GEMINI_API_KEY=
# GEMINI_MODEL=
