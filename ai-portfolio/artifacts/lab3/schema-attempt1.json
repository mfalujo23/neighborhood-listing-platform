{
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "property_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "street": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "city": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "state": {
        "type": "string",
        "enum": [
          "AL",
          "AK",
          "AZ",
          "AR",
          "CA",
          "CO",
          "CT",
          "DE",
          "DC",
          "FL",
          "GA",
