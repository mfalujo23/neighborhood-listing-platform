          "ID",
          "IL",
          "IN",
          "IA",
          "KS",
          "KY",
          "LA",
          "ME",
          "MD",
          "MA",
          "MI",
          "MN",
          "MS",
          "MO",
          "MT",
          "NE",
          "NV",
          "NH",
          "NJ",
          "NM",
          "NY",
          "NC",
          "ND",
          "OH",
          "OK",
          "OR",
          "PA",
          "RI",
          "SC",
          "SD",
          "TN",
          "TX",
          "UT",
          "VT",
          "VA",
          "WA",
          "WV",
          "WI",
          "WY"
        ]
      },
      "zip_code": {
        "type": "string",
        "pattern": "^\\d{5}(-\\d{4})?$"
      },
      "price": {
        "type": "number",
        "minimum": 0
      },
      "bedrooms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "bathrooms": {
        "type": "number",
        "minimum": 0
      },
      "square_feet": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "amenities": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "parking",
            "pool",
            "garden",
            "balcony",
            "air_conditioning",
            "pet_friendly"
          ]
        },
        "uniqueItems": true
      },
      "local_sponsors": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sponsor_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "sponsor_id",
            "name"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "property_id",
      "street",
      "city",
      "state",
      "zip_code",
      "price",
      "bedrooms",
      "bathrooms",
      "square_feet",
